# ═══════════════════════════════════════════════════════════
# Kleo Landing Page — Configuration
# Copy to .env and customise. All VITE_ vars are optional;
# defaults produce the standard Kleo branding.
# ═══════════════════════════════════════════════════════════

# ── Branding (white-label) ──
# VITE_BRAND_NAME="Kleo"
# VITE_BRAND_TAGLINE="Your AI Business Partner."
# VITE_BRAND_DESCRIPTION="I set up AI systems for your business..."
# VITE_BRAND_COLOR="#F97316"
# VITE_BRAND_COLOR_DARK="#EA580C"
# VITE_BRAND_COLOR_LIGHT="#FDBA74"

# ── Images (paths relative to /public) ──
# VITE_LOGO_IMAGE="/images/kleo-logo.png"
# VITE_CHARACTER_IMAGE="/images/kleo-character.png"
# VITE_BANNER_IMAGE="/images/kleo-banner.png"

# ── Phone ──
VITE_PHONE_NUMBER="+447861900580"

# ── Company / Legal ──
# VITE_COMPANY_NAME="Kno2gether Labs LTD"
# VITE_COMPANY_NUMBER="15454352"
# VITE_COMPANY_ADDRESS="Suite A 82 James Carter Road, Mildenhall, Ipswich, IP28 7DE"
# VITE_COMPANY_COUNTRY="United Kingdom"
# VITE_DOMAIN="heykleo.cloud"

# ── Backend (server.js — NOT exposed to browser) ──
WEBHOOK_URL="https://your-n8n-instance.com/webhook/kleo-lead"
WEBHOOK_API_KEY="change-me-to-a-real-key"
PORT=3000
