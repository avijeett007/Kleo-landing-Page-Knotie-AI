# Kleo Landing Page Configuration
# Copy this to .env and fill in your values

# Phone number displayed on the site (with country code)
VITE_PHONE_NUMBER="+447861900580"

# Webhook URL (N8N or any webhook endpoint) — called server-side only
WEBHOOK_URL="https://your-n8n-instance.com/webhook/kleo-lead"

# API key sent as X-API-Key header to protect your webhook
WEBHOOK_API_KEY="your-secret-api-key-here"

# Port for the production server
PORT=3000
